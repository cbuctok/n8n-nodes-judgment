            {
              "rankCandidateName": "Billing question",
              "rankCandidateDescription": "Charges, invoices, refunds"
            },
            {
              "rankCandidateName": "Password reset",
              "rankCandidateDescription": "Signing in or recovering an account"
            }
          ]
        },
        "rankInstructions": "Which topic best matches the request in the state?",
        "options": {}
      },
      "id": "ts-06-choice-rank",
      "name": "4. Choice Rank — candidates as rows",
      "type": "CUSTOM.judgment",
      "typeVersion": 1,
      "position": [
        40,
        -480
      ],
      "credentials": {
        "judgmentApi": {
          "id": "",
          "name": "Judgment account"
        }
      },
      "notes": "Expect candidates ordered by probability with the top match first."
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "d1",
              "name": "description",
              "value": "Fixed the null check in the payment handler. Also refactored the retry loop while I was in there, and bumped the SDK version to clear a known timeout bug.",
              "type": "string"
