{
  "name": "Judgment — End to End",
  "nodes": [
    {
      "parameters": {},
      "id": "ts-01-trigger",
      "name": "Start Here",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -1060,
        -260
      ],
      "notes": "Run this workflow to exercise every branch."
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "message",
              "value": "Hi, I've been trying to connect my Stripe account for 3 days and it keeps failing. I'm losing sales. Please help ASAP.",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "account",
              "value": "acme-labs",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "plan",
              "value": "growth",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "policy",
              "value": "Integration failures on paid plans are handled by the technical team within one business day.",
              "type": "string"
            }
          ]
        }
      },
      "id": "ts-02-ticket",
      "name": "Sample Ticket",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -840,
        -480
      ]
    },
    {
      "parameters": {
        "resource": "evaluation",
        "operation": "evaluate",
        "state": "fields",
        "stateFields": {
          "field": [
            {
              "fieldName": "message",
              "fieldValue": "={{ $json.message }}"
            },
            {
              "fieldName": "account",
              "fieldValue": "={{ $json.account }}"
            },
            {
              "fieldName": "policy",
              "fieldValue": "={{ $json.policy }}"
            }
          ]
        },
        "questions": {
          "question": [
            {
              "id": "urgency",
              "questionType": "noul",
              "trueDescription": "Explicitly time-sensitive",
              "falseDescription": "No urgency expressed",
              "questionInstructions": "Does `message` convey urgency or time-sensitivity?"
            },
            {
              "id": "department",
              "questionType": "choice",
              "choiceOptions": {
                "entry": [
                  {
                    "option": "billing",
                    "description": "Payments, invoicing, refunds"
                  },
                  {
                    "option": "technical",
                    "description": "Bugs, outages, integrations"
                  },
                  {
                    "option": "sales",
                    "description": "Pricing, upgrades, new accounts"
                  }
                ]
              },
              "questionInstructions": "Which team should handle `message`?"
            },
            {
              "id": "frustration",
              "questionType": "score",
              "levels": {
                "level": [
                  {
                    "description": "Calm, stating facts"
                  },
                  {
                    "description": "Frustrated but civil"
                  },
                  {
                    "description": "Very angry, strong language"
                  }
                ]
              },
              "questionInstructions": "How frustrated is the person writing `message`?"
            },
            {
              "id": "policy_supports",
              "questionType": "noul",
              "trueDescription": "",
              "falseDescription": "",
              "questionInstructions": "Does `policy` support handling `message` within a business day?"
            }
          ]
        },
        "options": {}
      },
      "id": "ts-03-evaluate",
      "name": "1. Evaluate — mixed questions",
      "type": "CUSTOM.judgment",
      "typeVersion": 1,
      "position": [
        -620,
        -480
      ],
      "credentials": {
        "judgmentApi": {
          "id": "",
          "name": "Judgment account"
        }
      },
      "notes": "Expect 4 items: urgency + policy_supports as probabilities, department as a choice with confidence, frustration as a score with a legend."
    },
    {
      "parameters": {
        "resource": "noul",
        "state": "text",
        "stateText": "={{ $json.message }}",
        "options": {
          "threshold": 0.7
        },
        "noulQuestions": {
          "noulQuestion": [
            {
              "noulName": "mentions_integration",
              "noulInstructions": "Does the message mention an integration?",
              "noulTrueDescription": "",
              "noulFalseDescription": ""
            },
            {
              "noulName": "mentions_revenue_loss",
              "noulInstructions": "Does the message mention losing sales or revenue?",
              "noulTrueDescription": "",
              "noulFalseDescription": ""
            }
          ]
        }
      },
      "id": "ts-04-noul",
      "name": "2. Noul — threshold",
      "type": "CUSTOM.judgment",
      "typeVersion": 1,
      "position": [
        -400,
        -480
      ],
      "credentials": {
        "judgmentApi": {
          "id": "",
          "name": "Judgment account"
        }
      },
      "notes": "Expect two items, each with probability and a boolean derived from the 0.7 threshold."
    },
    {
      "parameters": {
        "resource": "choice",
        "operation": "decide",
        "state": "json",
        "stateJson": "={{ { \"message\": $json.message, \"plan\": $json.plan } }}",
        "instructions": "Which team should handle this request given the plan in `plan`?",
        "decisionOptions": {
          "entry": [
            {
              "option": "billing",
              "optionDescription": "Payment or subscription issues"
            },
            {
              "option": "technical",
              "optionDescription": "Bugs or integration problems"
            },
            {
              "option": "sales",
              "optionDescription": "Pricing or account questions"
            }
          ]
        },
        "options": {}
      },
