      "credentials": {
        "judgmentApi": {
          "id": "",
          "name": "Judgment account"
        }
      },
      "notes": "Expect one item containing the ranked options with the selected one marked."
    },
    {
      "parameters": {
        "resource": "choice",
        "operation": "rank",
        "state": "text",
        "stateText": "={{ $json.message }}",
        "candidatesMode": "fields",
