{
  "name": "Route support tickets to a small or large model by difficulty with Judgment",
  "nodes": [
    {
      "parameters": {},
      "name": "Manual Test Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -1440,
        288
      ],
      "notes": "Run this workflow to see the same routing logic applied to five tickets."
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "tickets",
              "name": "tickets",
              "type": "array",
              "value": "[{\"ticketId\": \"T-1001\", \"ticket\": \"How do I change the email address on my account? I looked in settings but cannot find it.\"}, {\"ticketId\": \"T-1002\", \"ticket\": \"What are your support hours?\"}, {\"ticketId\": \"T-1003\", \"ticket\": \"Our nightly batch job that syncs inventory to our warehouse has started failing halfway through with a deadlock error. It worked until Tuesday. We are on the growth plan and this is blocking fulfilment.\"}, {\"ticketId\": \"T-1004\", \"ticket\": \"I was charged twice for order A-104 and I want a refund.\"}, {\"ticketId\": \"T-1005\", \"ticket\": \"Can you explain why the ledger service reconciles a 3-way match differently when a credit note lands in the same period as the original invoice? Our auditors flagged it and I need to know whether the accrual reversal is correct or whether we should restate.\"}]"
            }
          ]
        },
        "options": {}
      },
      "name": "Five Tickets",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1216,
        288
      ],
      "notes": "A batch of five tickets in one field. Replace with your inbox, helpdesk, or a webhook."
    },
    {
      "parameters": {
        "fieldToSplitOut": "tickets",
        "options": {}
      },
      "name": "One Item Per Ticket",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        -992,
        288
      ],
      "notes": "Turns the array into five items. The classifier then runs once per ticket."
    },
    {
      "parameters": {
        "resource": "evaluation",
        "operation": "evaluate",
        "state": "fields",
        "stateFields": {
          "field": [
            {
              "fieldName": "ticket",
              "fieldValue": "={{ $json.ticket }}"
            }
          ]
        },
        "questions": {
          "question": [
            {
              "id": "={{ $json.ticketId }}_intent",
              "questionType": "choice",
              "questionInstructions": "What is the primary intent of `ticket`?",
              "choiceOptions": {
                "entry": [
                  {
                    "option": "how_to",
                    "optionDescription": "Asking how to do something, or where to find a setting"
                  },
                  {
                    "option": "billing",
                    "optionDescription": "About a charge, invoice, refund or subscription"
                  },
                  {
                    "option": "incident",
                    "optionDescription": "Something is broken, failing or blocking work"
                  },
                  {
                    "option": "other",
                    "optionDescription": "Anything that does not fit the above"
                  }
                ]
              }
            },
            {
              "id": "={{ $json.ticketId }}_needs_expert",
              "questionType": "noul",
              "questionInstructions": "Does answering `ticket` require reasoning beyond routine procedure: diagnosing a cause, reconciling competing explanations, or advising on a specific case?",
              "trueDescription": "the answer needs diagnosis or case-specific reasoning",
              "falseDescription": "the answer follows from routine procedure or a documented policy"
            },
            {
              "id": "={{ $json.ticketId }}_has_policy_answer",
              "questionType": "noul",
              "questionInstructions": "Is `ticket` answerable with a short, factual answer that is standard for this product?",
              "trueDescription": "the answer is a fixed fact such as a setting location or a policy figure",
              "falseDescription": "the answer needs case-specific detail"
            }
          ]
        },
        "options": {}
      },
      "name": "Classify Tickets",
      "type": "n8n-nodes-judgment.judgment",
      "typeVersion": 1,
      "position": [
        -768,
        288
      ],
      "credentials": {
        "judgmentApi": {
          "id": "",
          "name": "Judgment API"
        }
      },
      "notes": "Runs once per ticket, and all three questions go out in ONE API call for that ticket. Each question id carries the ticket id, so every answer identifies the ticket it came from."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "r-hitl",
                    "leftValue": "={{ $json.intentConfidence }}",
                    "rightValue": 0.6,
                    "operator": {
                      "type": "number",
                      "operation": "lt"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Send to Human"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "r-policy",
                    "leftValue": "={{ $json.hasPolicyAnswer }}",
                    "rightValue": 0.5,
                    "operator": {
                      "type": "number",
                      "operation": "gte"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Answer From Policy"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "r-small",
                    "leftValue": "={{ $json.needsExpert }}",
                    "rightValue": 0.5,
                    "operator": {
                      "type": "number",
                      "operation": "lt"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Small Model"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Large Model"
        }
      },
      "name": "Route by Difficulty",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        352,
        256
      ],
      "notes": "Four destinations. Output 1 is a person, for tickets the classifier could not make sense of. The 0.5 and 0.6 thresholds live here, so changing them needs no new inference."
    },
    {
      "parameters": {},
      "name": "Answer From Policy",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        576,
        192
      ],
      "notes": "No model call at all. Attach your knowledge base lookup or a canned reply here."
    },
    {
      "parameters": {},
      "name": "Small Model",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        576,
        384
      ],
      "notes": "Attach a small, cheap chat model here. Routine tickets arrive on this branch: most of your traffic."
    },
    {
      "parameters": {},
      "name": "Large Model",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        576,
        576
      ],
      "notes": "Attach a larger reasoning model here. Only tickets the classifier flagged as needing reasoning arrive."
    },
    {
      "parameters": {},
      "name": "Send to Human",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        576,
        0
      ],
      "notes": "The classifier was unsure what this ticket even is. Route it to a person rather than paying a model to guess."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
